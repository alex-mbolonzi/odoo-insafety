<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_landlord_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Landlord Statement</h2>
                        <p><strong>Building:</strong> <span t-field="doc.building_id.name"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Unit</th>
                                    <th>Status</th>
                                    <th>Tenant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.building_id.property_ids" t-as="unit">
                                    <tr>
                                        <td><span t-field="unit.name"/></td>
                                        <td><span t-field="unit.status"/></td>
                                        <td>
                                            <t t-if="unit.current_rent_contract_id">
                                                <span t-field="unit.current_rent_contract_id.name"/>
                                            </t>
                                            <t t-else="">
                                                Vacant
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
